{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Credential Provider scaffold",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-credential-provider.ps1"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build LAN agent",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-lan-agent.ps1"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Android APK",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-android.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
